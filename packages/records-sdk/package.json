{
  "name": "@records/sdk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript SDK generated from the Records OpenAPI document (Python SDK in ./python).",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "types:check": "tsc --noEmit",
    "test:run": "vitest run",
    "generate": "node scripts/generate.ts",
    "test:python": "python3 -m unittest discover -s python/tests -t python"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "26.1.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
