{
  "extends": "../../cloudflare-os/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "noEmit": true
  },
  // The workerd half of the contract run type-checks under tsconfig.workerd.json (Workers types).
  "include": ["src", "__tests__", "vitest.config.ts", "vitest.workerd.config.ts"],
  "exclude": ["__tests__/workerd"]
}
