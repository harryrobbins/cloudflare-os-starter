{
  "name": "blueprint-network-map",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:gadget": "node scripts/build.mjs",
    "pack:gadget": "node scripts/build.mjs && node scripts/pack-gadget.mjs",
    "test:run": "vitest run && vitest run --config vitest.workers.config.ts",
    "test:e2e": "node --test --test-concurrency=1 e2e/harness.test.mjs e2e/profile.test.mjs e2e/design.test.mjs e2e/data.test.mjs",
    "harness": "node harness/serve.mjs",
    "test:platform": "node --test --test-concurrency=1 e2e/platform.test.mjs",
    "bench": "node e2e/bench.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@sigma/edge-curve": "3.1.0",
    "@sigma/node-border": "3.0.0",
    "@sigma/node-image": "3.0.0",
    "@sigma/node-square": "3.0.0",
    "capnweb": "catalog:",
    "d3-force": "3.0.0",
    "esbuild": "0.28.1",
    "graphology": "0.26.0",
    "graphology-layout-forceatlas2": "0.10.1",
    "playwright": "1.61.0",
    "sigma": "3.0.3",
    "vitest": "catalog:",
    "wrangler": "catalog:",
    "yjs": "13.6.31"
  }
}
