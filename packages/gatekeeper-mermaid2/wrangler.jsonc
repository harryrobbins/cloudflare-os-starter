{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gatekeeper-mermaid2",
  "main": ".wrangler/validate/src/index.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-09-30",
  "compatibility_flags": [
    "allow_irrevocable_stub_storage",
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "browser": {
    "binding": "BROWSER"
  },
  "assets": {
    "binding": "RENDERER_ASSETS",
    "directory": "./dist-renderer",
    "run_worker_first": true
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DiagramGatekeeper"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
