{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gatekeeper-procgen",
  "main": ".wrangler/validate/src/index.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["allow_irrevocable_stub_storage", "nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": []
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SyntheticDataGatekeeper"] }
  ],
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": true }
  }
}
