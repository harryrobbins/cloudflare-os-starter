{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "records-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "vars": { "RECORDS_ORIGIN": "", "ORIGIN_AUTH_MODE": "access" },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
