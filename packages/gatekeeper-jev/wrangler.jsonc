{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gatekeeper-jev",
  "main": ".wrangler/validate/src/index.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["allow_irrevocable_stub_storage", "nodejs_compat", "global_fetch_strictly_public"],
  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": ["JevGatekeeper"]
    }
  ],
  // OPENROUTER_API_KEY is installed with `wrangler secret put`, never written here.
  "secrets": { "required": ["OPENROUTER_API_KEY"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
