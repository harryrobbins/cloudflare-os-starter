{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gatekeeper-websearch",
  "main": ".wrangler/validate/src/index.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-08-04",
  // global_fetch_strictly_public: fetch() refuses private and reserved addresses after DNS
  // resolution, the same SSRF guard the Workshop's webFetch relies on.
  "compatibility_flags": ["allow_irrevocable_stub_storage", "nodejs_compat", "global_fetch_strictly_public"],
  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": ["WebSearchGatekeeper"]
    }
  ],
  // Document-to-Markdown conversion for fetched pages.
  "ai": { "binding": "AI" },
  // JSON arrays; scripts/deploy.ts fills them from deployment.jsonc.
  "vars": {
    "BLOCKED_TERMS": [],
    "PRIVATE_DOMAINS": [],
    "PUBLIC_HOSTS": []
  },
  // OPENROUTER_API_KEY is installed with `wrangler secret put`, never written here.
  "secrets": { "required": ["OPENROUTER_API_KEY"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
