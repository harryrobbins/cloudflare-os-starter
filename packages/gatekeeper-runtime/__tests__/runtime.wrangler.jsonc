{
  "name":"notebook-runtime-local-test",
  "main":"runtime-worker.ts",
  "compatibility_date":"2026-08-08",
  "compatibility_flags":["nodejs_compat"],
  "containers":[{"class_name":"PythonSandbox","image":"../Dockerfile","max_instances":5,"instance_type":"basic"}],
