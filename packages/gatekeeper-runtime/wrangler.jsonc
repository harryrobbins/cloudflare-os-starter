{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gatekeeper-runtime",
  "main": ".wrangler/validate/src/index.ts",
  "build": { "command": "pnpm exec capnweb-validate build --out .wrangler/validate", "watch_dir": "src" },
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["allow_irrevocable_stub_storage", "nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "containers": [{ "class_name": "PythonSandbox", "image": "./Dockerfile", "instance_type": "basic", "max_instances": 5 }],
  "durable_objects": { "bindings": [
    { "name": "PYTHON", "class_name": "PythonSandbox" },
    { "name": "SESSIONS", "class_name": "RuntimeSession" },
    { "name": "ACCOUNTS", "class_name": "RuntimeAccountState" }
  ] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PythonSandbox", "RuntimeSession", "RuntimeAccountState", "RuntimeGatekeeper"] }],
  "observability": { "enabled": true, "logs": { "invocation_logs": false }, "traces": { "enabled": true } }
}
