{
  // Cloudflare account that owns every Worker and provisioned resource.
  // Find it: https://developers.cloudflare.com/fundamentals/account/find-account-and-zone-ids/
  "accountId": "e1376e48400a20e631b61bbf16f555f1",

  // The deployment's public origin, used for PUBLIC_BASE_URL and to scope Context data.
  // null derives it from workers.router.route.customDomain.
  // Required when the router uses workersDev: the account's workers.dev subdomain is not
  // knowable from this file. Write it as a bare origin, no path and no trailing slash --
  // "https://<router-name>.<subdomain>.workers.dev".
  "publicBaseUrl": null,

  // Worker names are permanent service identities. Keep them unique within the account.
  // Reference: docs/customization.md#workers-and-routing
  "workers": {
    // Owns the public URL and serves the frontend. Proxies /api and /blueprint-screenshot to the
    // Workshop, and /gatekeeper/<name> to the matching Gatekeeper.
    "router": {
      "name": "cfos-router",

      // Production: use a hostname in an active Cloudflare zone. Wrangler creates DNS and TLS.
      // Evaluation: replace this with "route": { "workersDev": true } and set publicBaseUrl above.
      // https://developers.cloudflare.com/workers/configuration/routing/custom-domains/
      "route": { "customDomain": "cfos.surprisingly.ltd" }
    },

    // The Workshop backend. No public route: the router reaches it over a service binding.
    "workshop": { "name": "cfos-workshop" },
    "context": { "name": "cfos-context" },

    // The Scheduler Gatekeeper, which gives agents scheduled and recurring work. Ambient like
    // the Context Gatekeeper
    "scheduler": { "name": "cfos-scheduler" },

    // Credential-free, deterministic synthetic datasets. RPC-only; it has no public route.
    "procgen": { "name": "cfos-procgen" },

    "customGatekeeper": { "name": "cfos-custom-gatekeeper" },
    "errorReporter": { "name": "cfos-error-reporter" },

    // Team chat: serves its own app at /gatekeeper/chat/ through the router. Only deployed while
    // the "chat" block below is enabled.
    "chat": { "name": "cfos-chat" },

    // Privacy-gated web search and fetch. RPC-only; only deployed while the "webSearch" block
    // below is enabled.
    "webSearch": { "name": "cfos-websearch" },

    // Organisation Records: serves /gatekeeper/records/ through the router and is bound to the
    // Workshop as a Gatekeeper. Only deployed while the "records" block below is enabled.
    "records": { "name": "cfos-records" },

    // Jev decisions. RPC-only; only deployed while the "jev" block below is enabled.
    "jev": { "name": "cfos-jev" },

    // Omni-search: serves /gatekeeper/search/ through the router, and is bound to chat and the
    // Workshop. Only deployed while the "search" block below is enabled.
    "search": { "name": "cfos-search" }
  },

  // This starter deploys Cloudflare Access mode. Cloudflare OS also supports built-in password
  // accounts and auth Gatekeeper sign-in; see the reference below before switching. The audience
  // comes from the self-hosted Access application protecting the public hostname.
  // "admins" gates /admin in every sign-in method.
  // Reference: docs/customization.md#sign-in-methods
  "access": {
    "issuer": "https://surprisingly-pages.cloudflareaccess.com",
    "audience": "2124f7e5979d2e5c0797a49861f6900feccd5190f10f640b35ff33839a357256",
    "admins": ["harryrobbins@gmail.com"]
  },

  // Model catalog served through Cloudflare AI Gateway. Enabled by default: the Workshop reaches
  // the gateway over its WORKERS_AI binding, which is pre-authenticated inside your own account,
  // so no API token is needed.
  // Reference: docs/customization.md#ai-models
  "aiGateway": {
    "enabled": true,

    // Your account's AI Gateway. "default" is the one Cloudflare creates for the account.
    // Migrating from the hosted deploy? Use the gateway that flow created: "<instance>-ai"
    // (e.g. "cloudflareos-ai"), named after your instance. See docs/migrate-from-hosted.md.
    "name": "cfos-gateway",

    // null reuses the top-level accountId. Set only if the gateway lives in another account --
    // that requires CF_AI_GATEWAY_API_TOKEN, since the binding cannot reach across accounts.
    "accountId": null,

    // "cloudflare" is Workers AI, which needs no key of your own. anthropic/openai/openrouter need
    // keys stored on the gateway (BYOK); "google" additionally requires CF_AI_GATEWAY_API_TOKEN.
    // "openrouter" has no built-in catalogue, so it also needs entries under "models" below.
    "providers": ["openrouter"],

    // Deployment-owned model allow-list, merged over upstream's built-in catalogue. Keys are the
    // ids the provider's API takes -- for OpenRouter that is its own "vendor/model" id, and the
    // "~" alias prefix is a real OpenRouter id, not a typo. Provider API keys never go here: store
    // the OpenRouter key on the gateway named above as BYOK (docs/customization.md#ai-models).
    "models": {
      "openrouter": {
        "qwen/qwen3.8-flash": {
          "name": "Qwen 3.8 Flash (OpenRouter)", "contextWindow": 1000000, "outputLimit": 131072
        },
        "~deepseek/deepseek-flash-latest": {
          "name": "DeepSeek Flash latest (OpenRouter)", "contextWindow": 1048576, "outputLimit": 393216
        },
        "xiaomi/mimo-v2.6-pro": {
          "name": "Xiaomi MiMo V2.6 Pro (OpenRouter)", "contextWindow": 1048576, "outputLimit": 131072
        }
      }
    }
  },

  // Notebook Python execution. Enable after reviewing the new Worker/container deployment.
  // Cells and saved outputs work without it. No public route or new secrets are needed.
  "runtime": { "enabled": true, "workerName": "cfos-notebook-python", "maxInstances": 5 },

  "context": {
    // Isolates Context data shared by this Workshop deployment.
    // null scopes it to the public origin
    "sharingDomain": null,

    // null: Wrangler provisions and remembers a KV namespace on first deploy.
    // string: bind an existing namespace by ID.
    "kvNamespaceId": null

    // Optional Git-compatible storage for Context collections. To enable it, add a comma after
    // kvNamespaceId and uncomment this object. Requires Artifacts account access.
    // "artifacts": {
    //   "enabled": true,
    //   // Optional override; defaults to "gatekeeper-context-collections".
    //   "namespace": "custom-context-collections"
    // }
  },

  // Displayed to agents when the example custom integration is enabled in /admin.
  // Reference: docs/customization.md#custom-gatekeepers
  "customGatekeeper": {
    "name": "Surprisingly Ltd",
    "message": "This deployment belongs to Surprisingly Ltd. Keep answers concise and never expose credentials."
  },

  // Team chat for everyone who can sign in: one Worker, one SQLite Durable Object holding the
  // messages, and one R2 bucket holding uploaded files. Reachable at /gatekeeper/chat/ behind the
  // same Access application as the rest of the hostname; membership, display names and the admin
  // list all come from "access" above, so there is nothing to configure here about identity.
  // Reference: docs/customization.md#team-chat
  "chat": {
    // false deploys nothing chat-related: no Worker, no bucket, and no binding on the router or
    // the Workshop. The Durable Object and bucket survive being disabled; they are not deleted.
    "enabled": true,

    // null: Wrangler provisions and remembers an R2 bucket for uploads on first deploy.
    // string: adopt an existing bucket by name -- the way to keep files across a Worker rename.
    "filesBucket": null,

    // Hard cap per upload, in bytes (10 MiB). Becomes the Worker's MAX_UPLOAD_BYTES; an upload
    // arrives as one Worker request body, so the platform's 100 MiB is the ceiling here.
    "maxUploadBytes": 10485760,

    // @agent answers: a question in a public channel (or a DM with Agent) goes to the asker's own
    // Workshop account and model through the Workshop's ExternalMessageGateway, and the answer is
    // posted back as the Agent. Each colleague needs a Workshop account with an AI model before the
    // Agent can answer them. Absent or true binds it (the Workshop is then deployed before chat);
    // false turns replies off and chat says so. See packages/gatekeeper-chat/README.md, "Agent".
    "agentReplies": true

    // The agent-facing half: binds chat to the Workshop as a Gatekeeper vendor, so every workspace
    // gets an ambient ChatSession (public channels: read and search; posting is an approved action).
    // Off until that observer policy has been reviewed in /admin, and until the deployed chat
    // Worker exports the vendor entrypoint. To enable it, add a comma above and uncomment:
    // "agentAccess": true
  },

  // Explicit backend issue reports go to a private Worker that emits structured console errors.
  // Set release to a commit/version when your deployment pipeline has one.
  // Reference: docs/observability.md#quick-start
  "errorReporting": {
    "enabled": true,
    "environment": "production",
    "release": null
  },

  // Formats shipped with the deployment: a directory of <name>.gadget + <name>.json pairs, relative
  // to this file. It REPLACES upstream's Docs/Sheets/Slides, so formats/ carries copies of them
  // beside our Board. null ships upstream's set.
  // Reference: docs/customization.md#bundled-formats
  "formatBlueprintsDir": "formats",

  // null values use Wrangler automatic provisioning. Set IDs/names to reuse owned resources.
  // https://developers.cloudflare.com/workers/wrangler/configuration/#automatic-provisioning
  "resources": {
    "blueprintsKvNamespaceId": null,
    "avatarsKvNamespaceId": null,
    "blueprintContentBucket": null
  },

  // Structured custom logs stay enabled. Invocation logs and traces are separate volume controls.
  // https://developers.cloudflare.com/workers/observability/logs/workers-logs/
  "observability": {
    "enabled": true,
    "headSamplingRate": 1,
    "logs": { "invocationLogs": false },
    "traces": { "enabled": false, "headSamplingRate": 0.1 }
  },

  // Web search with a privacy gate: every query and URL is checked by pattern detectors and the
  // Jev decision model (via OpenRouter) before it leaves. Clear queries run at once, uncertain ones
  // wait for the user's approval, and personal data, identifiers or secrets are refused.
  // Needs an OpenRouter key on its Worker, never in this file:
  //   CLOUDFLARE_ACCOUNT_ID=<id> pnpm exec wrangler secret put OPENROUTER_API_KEY --name cfos-websearch
  // Plan: docs/plans/web-search-gatekeeper.md
  "webSearch": {
    "enabled": true,
    // Extra strings no query may contain, on top of the account ID and Access team domain.
    "blockedTerms": []
    // "privateDomains": absent derives "surprisingly.ltd" from the router's custom domain.
  },

  // Organisation Records: shared, organisation-owned project data in Postgres, reached through
  // Hyperdrive. Serves a machine API at /gatekeeper/records/v1/* and a connect flow for people at
  // /gatekeeper/records/connect, both through the router (still the only public entrypoint), and
  // is bound to the Workshop as a Gatekeeper. false deploys nothing Records-related and nothing in
  // this block is checked, so the placeholders below are fine while it stays off.
  //
  // Operator prerequisites, in order, before setting "enabled": true (nothing here is provisioned
  // by the deploy):
  //   1. Create the Postgres database.
  //   2. Apply the schema with the migration-owner connection string:
  //        RECORDS_MIGRATION_URL=<migration-owner-url> pnpm --filter @records/schema db:migrate
  //   3. Create login users for the records_app and records_publisher roles.
  //   4. Create two Hyperdrive configurations over that database -- one logging in as records_app
  //      (hyperdriveId), one as records_publisher (publisherHyperdriveId) -- each with query
  //      CACHING DISABLED (wrangler hyperdrive create ... --caching-disabled). Permission and
  //      registry reads must be fresh; the deploy cannot check this for you.
  //   5. Create the change queue and its dead-letter queue (defaults: <workers.records.name>-changes
  //      and <workers.records.name>-changes-dlq): wrangler queues create <name>.
  //   6. Create a separate, path-specific Access application for <public host>/gatekeeper/records/v1/*
  //      with a service token policy; its AUD tag is apiAccessAudience.
  //   7. Seed the organisation and its first admin (same migration-owner URL):
  //        RECORDS_MIGRATION_URL=<migration-owner-url> pnpm --filter @records/schema db:bootstrap \
  //          "<organisation>" <admin e-mail> "<admin name>"
  //   8. Fill in the values below and set "enabled": true. No Worker secrets are needed: database
  //      credentials live in the Hyperdrive configurations.
  // Plan: docs/plans/organisation-datastores.md
  "records": {
    "enabled": true,
    // Hyperdrive configuration IDs (32 hex characters), distinct, both with caching disabled.
    // Neon project jolly-silence-27253955 (aws-eu-west-2), direct endpoint; created 2026-09-24.
    "hyperdriveId": "7107e8c4ca8848f5a19b1279089ec753",
    "publisherHyperdriveId": "2e004047e7de47b094801a57ad34fb23",
    // AUD tag of the path-specific Access application for /gatekeeper/records/v1/*, or null to
    // keep the machine API switched off (every /v1 request refused) until that application exists.
    "apiAccessAudience": null
    // Optional queue names; absent uses the defaults above. To set them, add a comma above and
    // uncomment:
    // "changesQueue": "cfos-records-changes",
    // "deadLetterQueue": "cfos-records-changes-dlq"
  },

  // Jev decisions: TypeSafe's Jev decision model (yes/no, choice and score questions with
  // probabilities) for agents and Gadgets, as a connector. Jev answers OpenRouter's Decisions API
  // rather than chat completions, so it cannot be listed under aiGateway.models.
  // Needs an OpenRouter key on its Worker, never in this file:
  //   CLOUDFLARE_ACCOUNT_ID=<id> pnpm exec wrangler secret put OPENROUTER_API_KEY --name cfos-jev
  "jev": { "enabled": true },

  // Omni-search: one hybrid index (Vectorize for meaning, SQLite full-text for words and facets) over
  // team chat first, then more sources. Serves its app and API at /gatekeeper/search/ through the
  // router, behind the same Access application; identity and admins come from "access" above.
  // false deploys nothing search-related and nothing in this block is checked.
  //
  // Operator prerequisite: wrangler deploy cannot create a Vectorize index, so before the first
  // deploy (and after any change to the names below) run
  //   pnpm search:provision          # read-only: prints what is missing
  //   pnpm search:provision --yes    # creates the index (768 dims, cosine), its six metadata
  //                                  # indexes, the embed queue and its dead-letter queue
  // pnpm check and pnpm deploy verify all of them before building anything.
  // Reference: docs/customization.md#omni-search. Plan: docs/plans/omni-search.md
  "search": {
    "enabled": true,

    // Binds search to the Workshop as a Gatekeeper vendor, so every workspace gets an ambient,
    // read-only SearchSession and /find. It sees deployment-public content only (public channels,
    // public collections): the agent's session carries no identity.
    "agentAccess": true,

    // Binds search's SearchService to chat (requires chat.enabled): chat pushes messages into the
    // index and fuses meaning-based recall into its own search results.
    "chatFusion": true,

    // Indexes the Context Library's public collections every 15 minutes through a read-only
    // Context account minted by search. Private collections are never read.
    "contextFeed": true,

    // The Vectorize index. Absent uses workers.search.name. Its dimensions and metadata indexes
    // are fixed for life: a new name here means provisioning a new index and a backfill.
    "index": "cfos-search",

    // A reranking pass (bge-reranker-base) over the fused top 30. Slower and slightly dearer.
    "rerank": false
    // Optional queue names; absent uses <workers.search.name>-embed and
    // <workers.search.name>-embed-dlq. To set them, add a comma above and uncomment:
    // "embedQueue": "cfos-search-embed",
    // "deadLetterQueue": "cfos-search-embed-dlq"
  }
}
